int pirPin = 2;      
int ledPin = 13;    

void setup() {
  pinMode(pirPin, INPUT);
  pinMode(ledPin, OUTPUT);
  Serial.begin(9600);  
}

void loop() {
  int motion = digitalRead(pirPin);

  if (motion == HIGH) {
    digitalWrite(ledPin, HIGH);  
    Serial.println("Движение обнаружено!");
  } else {
    digitalWrite(ledPin, LOW);    
    Serial.println("Нет движения");
  }

  delay(200); 
}


