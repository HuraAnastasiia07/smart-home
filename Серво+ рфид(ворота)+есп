#include <SPI.h>
#include <MFRC522.h>
#include <ESP32Servo.h>

#define SS_PIN 5
#define RST_PIN 4

MFRC522 mfrc522(SS_PIN, RST_PIN);

Servo servo1;
Servo servo2;

#define SERVO1_PIN 14
#define SERVO2_PIN 27

void setup() {
  Serial.begin(115200);
  SPI.begin();
  mfrc522.PCD_Init();

  // Для ESP32 нужно указать частоту ШИМ
  servo1.setPeriodHertz(50);
  servo2.setPeriodHertz(50);

  servo1.attach(SERVO1_PIN, 500, 2400); // (пин, минимальная, максимальная ширина импульса)
  servo2.attach(SERVO2_PIN, 500, 2400);

  servo1.write(0);
  servo2.write(0);
}

void loop() {
  if (!mfrc522.PICC_IsNewCardPresent()) {
    return;
  }

  if (!mfrc522.PICC_ReadCardSerial()) {
    return;
  }

  Serial.print("RFID ключ найден: ");
  for (byte i = 0; i < mfrc522.uid.size; i++) {
    Serial.print(mfrc522.uid.uidByte[i], HEX);
    Serial.print(" ");
  }
  Serial.println();

  servo1.write(90);
  servo2.write(-90);

  delay(5000);

  servo1.write(0);
  servo2.write(90);

  mfrc522.PICC_HaltA();
}
