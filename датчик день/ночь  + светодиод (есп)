const int pinDO = 34;     // цифровой выход датчика (день/ночь)
const int pinAO = 35;     // аналоговый выход (уровень света)
const int pinLED = 25;    // пин для светодиода

void setup() {
  Serial.begin(115200);
  pinMode(pinDO, INPUT);
  pinMode(pinLED, OUTPUT);
  digitalWrite(pinLED, LOW); // LED выключен по умолчанию
}

void loop() {
  int digitalVal = digitalRead(pinDO);
  int analogVal  = analogRead(pinAO);

  Serial.print("Digital = ");
  Serial.print(digitalVal);
  Serial.print(" | Analog = ");
  Serial.println(analogVal);

  if (digitalVal != LOW) {   // темно
    Serial.println("🌙 Ночь -> включаем LED");
    digitalWrite(pinLED, HIGH);
  } else {                   // светло
    Serial.println("☀️ День -> выключаем LED");
    digitalWrite(pinLED, LOW);
  }

  delay(500);
}


Датчик

VCC → 3.3V 
GND → GND
D0 → GPIO 34
A0 —> GPIO 35

Светодиод 

+ через резистор 220–330 Ω → GPIO 25 .
- → GND
